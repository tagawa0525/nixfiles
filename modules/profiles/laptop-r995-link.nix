# =============================================================================
# Laptop のホームにある r995 の入口
# =============================================================================
# ~/r995/github から r995 の ~/github（NFS のマウント点。../slurm/nfs-entry.nix）を見られるようにする。
# マウント点そのものは ../slurm/submit.nix が作る。laptop.nix から import する。
#
# ~/r995 はローカルの実ディレクトリにし、NFS を指す symlink はその 1 階層下に置く。
# ~/r995 そのものを symlink にすると、starship が ~ の直下を stat するたびに automount が起動し、
# r995 に届かないとき（外出先など）はプロンプトがマウントの待ち時間のぶん止まる（docs/adr/0048）。
# =============================================================================
_:

{
  systemd.tmpfiles.rules = [
    "d /home/tagawa/r995 0755 tagawa users -"
    # L+ は既にあるものを消すので、上書きしない L にする（場所がふさがっていれば作らずに残り、手で移せる）
    "L /home/tagawa/r995/github - - - - ${import ../slurm/nfs-entry.nix}"
  ];
}
